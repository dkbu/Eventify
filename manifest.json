{
  "manifest_version": 2,
  "name": "Eventify",
  "version": "0.1.0",
  "description": "Adds a context-menu action for selected text in Firefox.",
  "permissions": ["contextMenus", "notifications"],
  "background": {
    "scripts": ["node_modules/moment/min/moment.min.js", "src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "eventify@example.com",
      "strict_min_version": "109.0"
    }
  }
}
