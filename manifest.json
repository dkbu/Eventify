{
  "manifest_version": 2,
  "name": "Eventify",
  "version": "0.1.0",
  "description": "Adds a context-menu action for selected text in Firefox.",
  "permissions": ["activeTab", "contextMenus"],
  "background": {
    "scripts": ["src/vendor/chrono.js", "src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "eventify@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
